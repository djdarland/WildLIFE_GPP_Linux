load_option  <<<-  fffalse  ??




loading  <<<-  fffalse  ??





non_strict(((lload)))??????



X:::lllload  ::-



	CM  ==  cccurrent_module,,,


	F  ==  fffeatures(((XX)))),,,,

	(

	    loading,,,!!!,,


	    load_2(((FF,,,,XXXX))))



	;

	    loading  <<<-  tttrue,,,


	    top_load  <<<-  ggget_choice,,,


	    load_2(((FF,,,,XXXX)))),,,,!!,,llloading  <<<-  fffalse


	;


	    open_out(((""stdout",,,,____))),,,,,,

	    open_in(((""stdin",,,,____))),,,,,,

	    set_module(((CCM)))),,,,

	    loading  <<<-  fffalse,,,


	    fail


	)....




load_2((([[FFF||||LLLLL]]],,,,XXXX)))) ::::-


	(

	    find_file(((XX....FFFFF,,,CCCCF)))),,,,!!,,


	    (

		has_feature(((CCF,,,,cccconsulted,,,BBBBBBool)))),,,,!!,,


		quiet_write(((""*** File """,,,,CCCCF,,,,"""""" is already loaded."))))



	    ;

		quiet_write(((""*** Loading File """,,,,CCCCF,,,,""""""")))),,,,

		first_load(((CCF))))



	    ),,,

	    load_2(((LL,,,,XXXX))))



	;

	    set_choice(((ttop_load))),,,,,,ffail


	)....



load_2((([[]]]))....




first_load(((CCF)))) ::::-


	(

	    load_option,,,!!!,,


	    consulted...CCCCCF  <<<-  tttrue,,,


	    simple_exp_load(((CCF))))



	;

	    consulted...CCCCCF  <<<-  fffalse,,,


	    simple_load(((CCF))))



	)...




find_file(((FF::::sssstring,,,CCCCF)))) ::::-


	!,,


        (

	    CF===sssstrcon(((bbi_load_path,,,





		      strcon(((FFFF,,,,



			     life_ext))))))))),,,

	    exists_file(((CCF)))),,,, !!

	;


	    write_err(((""*** File """,,,,FFFF,,,,"""""" not found.")))),,,,nnl_err,,,


	    fail  

	)....



find_file(((FF)))) ::::-


	write_err(((""*** Error: File name ")))),,,,

	writeq_err(((FF)))),,,,

	write_err((("" should be a string.")))),,,,

	nl_err,,,


	fail...





