import_clauses(((ffor  ==>  SSort,,,



               replacing  ==>  RRepList))) ::::-



	(

	    is_function(((SSort)))),,,,

	    (CConnect  ==  --->))) ;;;;

	    
	    is_predicate(((SSort)))),,,,

	    (CConnect  ==  :::-))) ;;;;

	    
	    write_err(((""*** Import: ",,,,SSSSort,,,,"""" is not a predicate or function")))),,,,

	    nl_err,,,


	    fail


        ),,,,

	! ,,


	get_and_replace(((SSort,,,,CCCConnect,,,,RRRRepList))));;;;

	succeed...






get_and_replace(((SSort,,,,CCCConnect,,,,RRRRepList)))) ::::-


	Connect===@@@@((SSort,,,,BBBBody)))),,,,

	clause(((CConnect)))),,,,

	%%	write("Importing clause:"),
	%%	nl,
	%%	writeq(Connect),
	%%	nl,
	replace(((((((CConnect,,,,RRRRepList)))),,,,

	%%	write("as clause:"),
	%%	nl,
	%%	writeq(Connect),
	%%	nl,
	%%	nl,
	R========rrrroot_sort(((CConnect....11111)))),,,,

	dynamic(((RR)))),,,,

	assert(((CConnect)))),,,,

	fail...






