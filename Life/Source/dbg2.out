load_exp_2((([[FFF||||LLLLL]]],,,,XXXX)))) ::::-


	(

	    find_file(((nnew_suffix(((XXXX....FFFFF,,,"""".exp")))),,,,CCCF)))),,,,!!,,


	    (

		has_feature(((CCF,,,,cccconsulted,,,BBBBBBool)))),,,,!!,,


		quiet_write_err(((""*** File """,,,,CCCCF,,,,"""""" is already loaded."))))



	    ;

		consulted...CCCCCF  <<<-  fffalse,,,


		quiet_write_err(((""*** Loading File """,,,,CCCCF,,,,""""""")))),,,,

		simple_load(((CCF))))



	    ),,,

	    load_exp_2(((LL,,,,XXXX))))



	;

	    set_choice(((ttop_load))),,,,,,ffail


	)....



load_exp_2((([[]]]))....




