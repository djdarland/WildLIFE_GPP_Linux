%%% proving queries of a file

non_strict(((((((((pprocess_query))) ??????



process_query(((QQuery,,,,SSSStreamIn,,,,SSSStreamOut)))) ::::-


	(

%%%	    has_feature(combined_name(Query),expansion_methods_table,M),
%%%	    M :\== [],!,
%%%	    process_declaration(Query,StreamOut)
%%%	;
	    
	    retract((((((((( llload_query  ::-  @@@ )))))),,,

	    assert((((( llload_query  ::-  QQQuery  )))))),,,

	    open_in(((""stdin",,,,____))),,,,,,

	    
	    @ ==  cccall_once(((lload_query))),,,,,,

	    
	    set_input(((SStreamIn)))),,,,

	    cond((( eexpand2file,,,





	        output_query(((QQQQuery,,,,SSSStreamOut))))



	    ),,,

	    fail


	;


	    succeed


	)....




dynamic(((lload_query))) ??????



load_query...






output_query(((QQuery,,,,SSSStreamOut)))) ::::-


	set_output(((SStreamOut)))),,,,

	cond((( QQuery  :::==  llload,,,



	      write_canonical(((mmmmodify_load(((QQQQuery)))))))),,,


	      cond((( QQQQuery  :::==  iiimport,,,



		    write_canonical(((mmmmodify_import(((QQQQuery)))))))),,,


		    write_canonical(((QQQQuery))))



		  )


	    ),,,

	write(((""?")))),,,,nnl,,,nnnl,,,


	open_out(((""stdout",,,,____)))......




modify_load(((XX)))) ---->


	load_exp  &&  ssstrip(((XX))))....



modify_import(((XX)))) ---->


	import_exp&&&sssstrip(((XX))))....






%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Processing declarations
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


%%% asserting declarations of a file

process_declaration(((((((((DDeclaration,,,,SSSStreamOut)))) ::::-


	(

	    term_xpand(((DDeclaration,,,,NNNNewDefs)))),,,,!!,,


	    process_defs(((NNewDefs,,,,SSSStreamOut))))



	;

	    nl_err,,,


	    write_err(((""*** Error: ")))),,,,nnl_err,,,wwwrite_err(((""    ")))),,,,

	    writeq_err(((DDeclaration)))),,,,wwrite_err((("".")))),,,,nnl_err,,,


	    write_err(((""    could not be expanded in file """,,,,



	                   loading_file,,,""""""""",,,,"""" near line ",,,,lllline,,,"""""".")))),,,,

	    nl_err


	)....





term_xpand(((AA,,,,BBBB)))) ::::-


	(

	    has_feature(((ccombined_name(((AAAA)))),,,,eeexpansion_methods_table,,,MMMMMM)))),,,,!!,,


	    composed_expansion(((AA,,,,BBBB,,,,MMMM,,,,ffffile  ==>  lloading_file,,,lllline  ==>  lline))),,,,!! 

	;


	    (

		clause((((( ttterm_expansion(((AA)))) ::::-  @@ ))))))


	    ;

	        clause((((( ttterm_expansion(((AA)))) )))))))


	    ),,,!!,,


	    term_expansion(((AA,,,,BBBB,,,,



			   file  ==>  lloading_file,,,



			   line  ==>  lline))),,,,!!

	;


	    A  ==  BBB


	)....





process_defs(((NNewDefs,,,,SSSStreamOut)))) ::::-


	(

	    expand2file,,,


	    set_output(((SStreamOut)))),,,,

	    cond((( NNewDefs  :::=<  lllist,,,



		  maprel(((wwwwrite_def,,, NNNNNNewDefs)))),,,,


		  write_def(((NNNNewDefs))))



		),,,

	    open_out(((""stdout",,,,____))),,,,,,

	    fail


	;


	    assert_rules,,,


	    cond((( NNewDefs  :::=<  lllist,,,



		  maprel(((aaaassert_def,,, NNNNNNewDefs)))),,,,


		  assert_def(((NNNNewDefs))))



		),,,

	    fail


	;


	    succeed


	)....




assert_def(((XX)))) ::::-


	cond((( BBool::::((((cconsulted...llllloading_file))),,,,


	      cond((( XXXX  :::==  (((-->))),,,,


		    Bool....cccccurrent_module...fffffunctions...(((((XX...11111)))) <<<<<-  ttrue,,,



		    cond((( XXXX  :::==  (((::-))),,,,


			  Bool....cccccurrent_module...pppppreds...(((((XX...11111)))) <<<<<-  ttrue,,,



			  cond((( XXXX  :::==  (((<<|))) oooor  XX  ::==  (((:::))) oooor  XX  ::==  (((::=))),,,,


				succeed,,,





				Bool....cccccurrent_module...pppppreds...XXXXX  <<<-  tttrue  

			      )



			)


		  )


	    ),,,

	assert(((XX))))....




write_def(((XX)))) ::::-


	write_canonical(((XX)))),,,,

	write((("".")))),,,,

	nl,,,nnnl...







%%% writing syntax errors

write_syntax_error((((SStreamIn,,,,SSSStreamOut)))) ::::-


	close(((SStreamIn)))),,,,

	cond((( eexpand2file,,,





	    close(((SSSStreamOut))))



	),,,

	fail...		






