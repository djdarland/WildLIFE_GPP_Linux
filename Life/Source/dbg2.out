%%% A more useful listing predicate from the c_listing built-in.

non_strict(((((((((((((((((llisting)))??????



X:::llllisting  ::-



	%%	trace(T,U),   % RM: Dec  9 1992 
	listing_2((((ffeatures(((XXXX)))),,,, XXX))))....



	%%	trace(T,U).

listing_2(((([[]]],,    ____))) ::::::-  !!..




listing_2((([[FFF]]]],,,,   XXXX)))) ::::-  !!,, nnnl,,, lllisting_3(((FF,,,, XXXX))))....



listing_2((([[FFF||||LLLLL]]],,,, XXXX)))) ::::-  nnl,,, lllisting_3(((FF,,,, XXXX)))),,,, llisting_2(((LL,,,, XXXX))))....




listing_3(((FF,,,, XXXX)))) ::::-  PP===XXXX...FFFFF,,, ccc_listing(((PP)))),,,, llisting_4(((PP))))....




listing_4(((PP)))) ::::-  vvar(((PP)))),,,, !!,,


        write(((""% '@' is the top sort.")))),,,, nnl...




%% listing_4(P:int)    :- !, listing_4a(int).      
%% listing_4(P:real)   :- !, listing_4a(real).     
%% listing_4(P:string) :- !, listing_4a(string).   
listing_4((((((PP)))) ::::-  llisting_4a(((PP))))....                  



listing_4a(((PP)))) ::::-  iis_sort(((PP)))),,,, iis_value(((PP))))====fffalse,,, !!!,, 


	listing_5(((pparents(((PPPP)))),,,, PPP)))),,,,

        listing_6(((cchildren(((PPPP)))),,,, PPP))))....



	% write("% Parents: "),writeq(parents(P)), nl,
	% write("% Children: "),writeq(children(P)), nl.


listing_4a(((((__)))......




listing_5((([[]]],, ____))) ::::::-  !!..




listing_5((([[XXX||||XXXXXs]]],,,, YYYY)))) ::::-


	writeq(((YY)))),,,, wwrite((("" <| ")))),,,, wwriteq(((XX)))),,,, wwrite((("".")))),,,, nnl,,,


	listing_5(((XXs,,,, YYYY))))....




listing_6((([[]]],, ____))) ::::::-  !!..




listing_6((([[XXX||||XXXXXs]]],,,, YYYY)))) ::::-


	writeq(((XX)))),,,, wwrite((("" <| ")))),,,, wwriteq(((YY)))),,,, wwrite((("".")))),,,, nnl,,,


	listing_6(((XXs,,,, YYYY))))....





%%% An op predicate that handles any pattern of arguments. 

non_strict((((oop)))??????



op(((PP,,,,KKKK,,,,FFFF,,,,pppprecedence===>PPP,,,kkkkind===>KKK,,,ffffunctor===>FFF))) ::::-


	trace(((TT,,,,UUUU)))),,,,

	( oop_2(((PP,,,,KKKK,,,,FFFF)))),,,, ttrace(((TT,,,,UUUU))))



	; ttrace(((TT,,,,UUUU)))),,,, ffail


	)....




op_2(((PP,,,,KKKK,,,,FFFF)))) ::::-  nnonvar(((PP)))),,,, nnonvar(((KK)))),,,, nnonvar(((FF)))),,,, FF===llllist,,, !!!,, ooop_3(((FF,,,,PPPP,,,,KKKK))))....



op_2(((PP,,,,KKKK,,,,FFFF)))) ::::-  nnonvar(((FF)))),,,, FF===llllist,,, !!!,,


	write_err(((""*** Error: invalid operator declaration.")))),,,,

	nl_err...




op_2(((PP,,,,KKKK,,,,FFFF)))) ::::-  nnonvar(((PP)))),,,, nnonvar(((KK)))),,,, nnonvar(((FF)))),,,, !!,, ccc_op(((PP,,,,KKKK,,,,FFFF))))....



op_2(((PP,,,,KKKK,,,,FFFF)))) ::::-  mmember(((oop(((PPPP,,,,KKKK,,,,FFFF)))),,,,ooops)))......




% List of operators.
op_3(((([[]]])) ::::-  !!..




op_3((([[HHH||||TTTTT]]],,,,PPPP,,,,KKKK)))) ::::-  oop_2(((PP,,,,KKKK,,,,HHHH)))),,,,oop_3(((TT,,,,PPPP,,,,KKKK))))....





%%% Default call handler.
%%% This is called for predicates that have no definition.
%%% More sophisticated call handlers can be written to do auto-loading
%%% of undefined predicates.

call_handler(((((((PP)))) ::::-  iis_sort(((PP)))),,,, !!,,


	write_err(((""*** Error: the sort '")))),,,,wwriteq_err(((PP)))),,,,

        write_err(((""' occurs where a predicate or function is expected.")))),,,,

	nl_err,,, aaabort...




call_handler(((PP)))) ::::-  !!,,


	write_err(((""*** Error: '")))),,,,wwriteq_err(((PP)))),,,,

        write_err(((""' is not a predicate or a function.")))),,,, nnl_err,,,


	abort...






%%% Pause for N seconds.
pause((((NN)))) ::::-


	S===rrrreal_time,,,


	repeat,,,


	real_time---SSSS>>>NNNN,,,


	!..





%%% Time a goal (whether it succeeds or fails).
run((((GG)))) ::::-


	S===ccccpu_time,,,


	(GG;;;sssucceed))),,,,

	!,,


	write(((""Time = ",,,,ccccpu_time---SSSSSS,,,"""" sec")))),,,,

	nl...






%%% Personal customizing.

init  :::-



	exists_file(((""./.wild_life")))),,,,

	simple_load(((""./.wild_life")))),,,,

	quiet_write(((""Loaded customizing file from current directory.")))),,,,

	!..





init  ::-



	exists_file(((""~/.wild_life")))),,,,

	simple_load(((""~/.wild_life")))),,,,

	quiet_write(((""Loaded customizing file from home directory.")))),,,,

	!..





init  ::-



	quiet_write(((""No customizing file loaded.")))),,,,

	!..





