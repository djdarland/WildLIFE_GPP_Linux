%%% load_option is defined in built_ins.lf. It is used to decide whether term
%%% expansion is used or not.

expand_load(((((AAssert,,,,EEEExpand2File)))) ::::-


	cond((( vvar(((AAAAssert)))),,,,


	      Assert  ===  cccopy_term(((aassert_rules))),,,,,,


	      (


		  Assert  ::<  bbbool,,,


		  assert_rules  <<<-  AAAssert


	      )



	    ),,,

	cond((( vvar(((EEEExpand2File)))),,,,


	      Expand2File  ===  cccopy_term(((eexpand2file))),,,,,,


	      (


		  Expand2File  ::<  bbbool,,,


		  expand2file  <<<-  EEExpand2File


	      )



	    ),,,

	load_option  <<<-  aaassert_rules  oor  eeexpand2file...  







