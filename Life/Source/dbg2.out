	M  ==  pppsi2str(((MM1)))),,,,

	%% set_module(M),
	retract_functions((((ffeatures(((BBBB....MMMMM1...fffffunctions,,,MMMM)))),,,,BBB....MMMMM1...fffffunctions))),,,, 

	retract_predicates(((ffeatures(((BBBB....MMMMM1...pppppreds,,,MMMM)))),,,,BBB....MMMMM1...pppppreds)))....



retract_modules((([[]]]))....




retract_functions((([[FFF||||FFFFFs]]])))) ::::-  !!,,


	(

	    retract_all_f(((FF))))



	;

	    retract_functions(((FFs))))



	)...



retract_functions((([[]]]))....



retract_predicates((([[FFF||||FFFFFs]]])))) ::::-  !!,,


