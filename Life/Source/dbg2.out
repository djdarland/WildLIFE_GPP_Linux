%%% simple_exp_load
%%% a 'simple_load' predicate using read, expanding facts when necessary,
%%% and writing the expanded version if asked.

simple_exp_load(((((((((((FFile)))) ::::-


	OldFile  <<-  rrroot_sort(((lloading_file))),,,,,,

	OldLine  <<-  rrroot_sort(((lline))),,,,,,

	line  <<-  @@@,,


	cond((( OOldFile  :::==  @@@,, OOOOldFile  ===  """?"))),,,,

	loading_file  <<-  FFFile,,,


	CM  ==  cccurrent_module,,,


	open_in(((FFile,,,,SSSStreamIn)))),,,,

	cond((( eexpand2file,,,





	      open_out(((nnnnew_suffix(((FFFFile,,,,"""".exp")))),,,,SSStreamOut))))



	    ),,,

	consulted...FFFFFile  <<<-  tttrue,,,


	load_expanded(((SStreamIn,,,,SSSStreamOut)))),,,,

	set_module(((CCM)))),,,,

	file  <<-  OOOldFile,,,


	line  <<-  OOOldLine...





load_expanded(((SStreamIn,,,,SSSStreamOut)))) ::::-


	(

	    next_rule(((EExpr,,,,TTTType,,,,EEEEnd,,,,lllline))),,,,,,

	    ( EEnd,,,!!!,,


	      close(((SStreamIn)))),,,,

	      cond((( eexpand2file,,,





		    close(((SSSStreamOut))))



		  )


	    ;

	      cond((( TType  :::==  dddeclaration,,,



		    process_declaration(((EEEExpr,,,,SSSStreamOut)))),,,,


		    cond((( TTTType  :::==  qqquery,,,



			  process_query(((EEEExpr,,,,SSSStreamIn,,,,SSSStreamOut)))),,,,


			  (


			      set_choice(((ttop_load))),,,,,,

			      write_syntax_error(((SStreamIn,,,,SSSStreamOut))))



			  )


			)


		  ),,,

	      fail


	    )



	;

	    load_expanded(((SStreamIn,,,,SSSStreamOut))))



	)...




next_rule(((XX,,,,TTTType,,,,BBBBool,,,,LLLLine)))) ::::-


	read(((XX,,,,TTTType,,,,LLLLine)))),,,,

	Bool  ==  ((( XX  ::=<  eeend_of_file)))...






