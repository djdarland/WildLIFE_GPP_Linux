	;

	    retract_predicates(((FFs))))



	)...



retract_predicates((([[]]]))....





retract_all_f(((FF)))) ::::-


	retract(((((FFF  -->  @@@)))))),,,

	retract_all_f(((FF))))....



retract_all_p(((FF)))) ::::-


	retract(((((FFF  ::-  @@@)))))),,,

	retract_all_p(((FF))))....






