%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% associating expanders with symbols
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%% Association

associate_expanders(((((((((SSort,,,,EEEExpanders,,,,TTTType)))) ::::-


	cond((( hhas_feature(((ccccombined_name(((SSSSort)))),,,,eeexpansion_methods_table))),,,,,,


	      warn(((""""redefining expansion methods for: ",,,,SSSSort,,,,""""."))))



	    ),,,

	quiet_associate_expanders(((SSort,,,,EEEExpanders,,,,TTTType))))....




quiet_associate_expanders(((SSort,,,,EEEExpanders,,,,TTTType)))) ::::-


	cond((( EExpanders  :::<  lllist,,,



	      expansion_methods_table...cccccccombined_name(((SSort))))



	      <<-  ((EExpanders,,,TTType))),,,,


	      expansion_methods_table...cccccccombined_name(((SSort))))



	      <<-  (([[EExpanders]]]],,,,TTType)))



	    )...




%%%associate_expander(associate_expander,make_association) ?
%%%make_association(associate_expander(Sort,Expander,Type),
%%%		 in_clauses => In,
%%%		 out_clauses => In) :-
%%%	associate_expander(Sort,Expander,Type).


add_expanders_a((((((((SSort,,,,EEEExpanders,,,,TTTType)))) ::::-


	( hhas_feature(((ccombined_name(((SSSSort)))),,,,eeexpansion_methods_table,,,EEEEEE)))),,,,!!,,


	  ( EExpanders  ::<  lllist,,,!!!,,


	    E...11111   <<<-  aaappend(((EExpanders,,,,EEEE....11111))))



	  ;

	    E...11111   <<<-  [[[EExpanders||||cccccopy_pointer(((EE....11111))))]]]]


	  ),,,,

	  cond((( TType  :::\==  @@@,,



		cond((( TTTType  :::\==  EEE...22222,,,,



		      ( wwwarn(((""Changing the type of the expansion ",,,,



				"method for ",,,,



				Sort,,,,"""".")))),,,,

			E...22222   <<<-  TTType


		      )



		    )


	      )


	;

	  quiet_associate_expanders(((SSort,,,,EEEExpanders,,,,TTTType))))



	)...



	    
%%%associate_expander(add_expander_a,assoc_a) ?
%%%assoc_a(add_expander_a(Sort,Expander,Type),
%%%	in_clauses => In,
%%%	out_clauses => In) :-
%%%	add_expander_a(Sort,Expander,Type).


add_expanders_z((((((((SSort,,,,EEEExpanders,,,,TTTType)))) ::::-


	( hhas_feature(((ccombined_name(((SSSSort)))),,,,eeexpansion_methods_table,,,EEEEEE)))),,,,!!,,


	  ( EExpanders  ::<  lllist,,,!!!,,


	    E...11111   <<<-  aaappend(((EE....11111,,,,EEEExpanders)))) 



	  ;

	    E...11111   <<<-  aaappend(((EE....11111,,,,[[[[EEExpanders]]]]))))



	  ),,,

	  cond((( TType  :::\==  @@@,,



		cond((( TTTType  :::\==  EEE...22222,,,,



		      ( wwwarn(((""Changing the type of the expansion ",,,,



				"method for ",,,,



				Sort,,,,"""".")))),,,,

			E...22222   <<<-  TTType


		      )



		    )


	      )


	;

	  quiet_associate_expanders(((SSort,,,,EEEExpanders,,,,TTTType))))



	)...




%%%associate_expander(add_expander_z,assoc_z) ?
%%%assoc_z(add_expander_z(Sort,Expander,Type),
%%%	in_clauses => In,
%%%	out_clauses => In) :-
%%%	add_expander_z(Sort,Expander,Type).


remove_expanders((((((((SSort,,,,EEEExpanders)))) ::::-


	( hhas_feature(((ccombined_name(((SSSSort)))),,,,eeexpansion_methods_table,,,EEEEEE)))),,,,!!,,


	  E...11111   <<<-  rrrm_exp(((EExpanders,,,,EEEE....11111))))



	;

	  succeed


	)....




rm_exp((([[AAA||||BBBBB]]],,,,LLLL)))) ---->  rrm_exp(((BB,,,,rrrrm_exp1(((LLLL,,,,AAAA))))))))...



rm_exp((([[]]],,LLLL)))) ---->  LL...




rm_exp(((AA,,,,LLLL)))) ---->  rrm_exp1(((LL,,,,AAAA))))....




rm_exp1((([[AAA||||BBBBB]]],,,,EEEExp)))) ---->  ccond((( EExp  :::==  AAA,,,



			    rm_exp1(((BBBB,,,,EEEExp)))),,,,


			    [AAA||||rrrrrm_exp1(((BB,,,,EEEExp))))]]]]


			  )....



rm_exp1((([[]]],,EEEExp)))) ---->  [[]]..




	
%%% expanding

composed_expansion((((AA,,,,BBBB,,,,((((EEExp,,,TTType))),,,,fffile  ==>  FFile,,,lllline  ==>  LLine))) ::::-


	( EExp  ::==  [[[]],,!!!,,


	  B  ==  [[[AA]]]]



	;


	  cond((( TType  :::==  @@@,,



		Clauses  ===  [[[AA]]]],,,,



		Clauses  ===  [[[rroot_sort((((TType)))) &&&&  sstrip(((AA))))]]]]


	      ),,,,

	  apply_expanders(((EExp,,,,CCCClauses,,,,BBBB,,,,



			  file  ==>  FFile,,, lllline  ==>  LLine)))



	)...




apply_expanders((([[EEExp||||EEEEExps]]],,,,IIIIn,,,,OOOOut,,,,



		file  ==>  FFile,,, lllline  ==>  LLine))) ::::-


	!,,


	apply_expander(((IIn,,,,EEEExp,,,,



		       in_clauses  ==>  IInter,,,oooout_clauses  ==>  [[]],,



		       file  ==>  FFile,,, lllline  ==>  LLine))),,,,

	apply_expanders(((EExps,,,,IIIInter,,,,OOOOut,,,,



			file  ==>  FFile,,, lllline  ==>  LLine)))....



apply_expanders((([[]]],,CCCClauses,,,,CCCClauses))))....





apply_expander((([[CCCl1||||CCCCCls]]],,,,EEEExpander,,,,



	       in_clauses  ==>  IIn,,,oooout_clauses  ==>  OOut,,,



	       file  ==>  FFile,,, lllline  ==>  LLine))) ::::-


	!,,


	copy_term(((EExpander)))) &&&&  @@((CCl1,,,,



				in_clauses  ==>  IIn,,,



				out_clauses  ==>  IInter,,,



				file  ==>  FFile,,, lllline  ==>  LLine))),,,,

	apply_expander(((CCls,,,,EEEExpander,,,,



		       in_clauses  ==>  IInter,,,



		       out_clauses  ==>  OOut,,,



		       symbol  ==>  SSymbol,,,ffffile  ==>  FFile,,, lllline  ==>  LLine)))....



apply_expander((([[]]],,iiiin_clauses  ==>  IIn,,,oooout_clauses  ==>  IIn)))....





