reconsult_2((([[FFF||||LLLLL]]],,,,XXXX)))) ::::-


	find_file(((XX....FFFFF,,,CCCCF)))),,,,!!,,


	(

	    has_feature(((CCF,,,,cccconsulted,,,BBBBBBool)))),,,,!!,,


	    (

		Bool,,,!!!,,


		reload(((CCF,,,,BBBBool))))



	    ;

		write_err(((""*** File """,,,,CCCCF,,,,"""""" cannot be reconsulted.")))),,,,

		nl_err


	    )



	;

	    quiet_write(((""*** Loading File """,,,,CCCCF,,,,""""""")))),,,,

	    first_load(((CCF))))



	),,,

	reconsult_2(((LL,,,,XXXX))))....



reconsult_2((([[]]]))....





reload(((CCF,,,,BBBBool)))) ::::-


	retract_file(((BBool)))),,,,

	quiet_write(((""*** Reconsulting File """,,,,CCCCF,,,,""""""")))),,,,

	quiet_write((("" ")))),,,,

	quiet_write(((""*** Warning: sort,public,non_strict and operators ",,,,



		    "declarations are not undone.")))),,,,

	quiet_write(((""***          Rules added using queries in the ",,,,



		    "file are not retracted.")))),,,,

	quiet_write((("" ")))),,,,

	first_load(((CCF))))....





retract_file(((BB)))) ::::-


	X  ==  cccurrent_module,,,


	retract_modules(((ffeatures(((BBBB)))),,,,BBB)))),,,,

	set_module(((XX))))....




